{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Squitle",
  "version": "0.1.0",
  "identifier": "app.squitle.timeline",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Squitle", "width": 1100, "height": 760, "minWidth": 760, "minHeight": 520 }],
    "security": { "csp": "default-src 'self'; style-src 'self'; script-src 'self'" }
  },
  "bundle": { "active": true, "targets": ["app", "dmg"], "category": "Productivity", "shortDescription": "Schedule quickly in TimeLine", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"] }
}
