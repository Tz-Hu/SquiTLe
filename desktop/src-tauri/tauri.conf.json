{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Squitle",
  "version": "0.2.0",
  "identifier": "app.squitle.timeline",
  "build": { "beforeBuildCommand": "pnpm --dir .. run build:desktop-ui", "frontendDist": "../dist-ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Squitle · TimeLine", "width": 1440, "height": 920, "minWidth": 980, "minHeight": 680 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: blob:; connect-src 'self' https:; font-src 'self' data:" }
  },
  "bundle": { "active": true, "targets": ["app", "dmg"], "createUpdaterArtifacts": true, "category": "Productivity", "shortDescription": "Schedule quickly in TimeLine", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"], "macOS": { "signingIdentity": "-" } }
}
